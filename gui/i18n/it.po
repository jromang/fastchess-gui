msgid "  decided at {}"
msgstr "  deciso a {}"

msgid " (decided at {})"
msgstr " (deciso a {})"

msgid " Export:"
msgstr " Esporta:"

msgid " · UCI: {} steps passed"
msgstr " · UCI: {} passi superati"

