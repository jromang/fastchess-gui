msgstr " · affinità"

msgid " · round trip {:.1f} ms"
msgstr " · andata e ritorno {:.1f} ms"

msgid " — not a UCI engine? For a WinBoard engine, choose the WinBoard protocol."
msgstr " — non è un motore UCI? Per un motore WinBoard, scegli il protocollo WinBoard."

msgid "! {} pair with one game only"
msgid_plural "! {} pairs with one game only"
msgstr[0] "! {} coppia con una sola partita"
msgstr[1] "! {} coppie con una sola partita"

msgid "! {} wrong PVs, on the moves in this colour"
msgstr "! {} PV errate, sulle mosse di questo colore"

msgid "%.1f pawns"
msgstr "%.1f pedoni"

msgid "%d cores"
msgstr "%d core"

msgid "%d games × %d threads > %d available threads."
msgstr "%d partite × %d thread > %d thread disponibili."

msgid "%d plies"
msgstr "%d semimosse"

msgid "%d · every move alike"
msgstr "%d · tutte le mosse alla pari"

msgid "%d · moves by their weights"
msgstr "%d · mosse secondo il loro peso"

msgid "%d · the best moves only"
msgstr "%d · solo le mosse migliori"

msgid "%d · toward every move alike"
msgstr "%d · verso tutte le mosse alla pari"

msgid "%d · toward the best moves"
msgstr "%d · verso le mosse migliori"

