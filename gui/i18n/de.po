msgid " Export:"
msgstr " Export:"

msgid " · UCI: {} steps passed"
msgstr " · UCI: {} Schritte bestanden"

msgid " · affinity"
msgstr " · Affinität"

msgid " · round trip {:.1f} ms"
msgstr " · Umlaufzeit {:.1f} ms"

msgid " — not a UCI engine? For a WinBoard engine, choose the WinBoard protocol."
msgstr " — keine UCI-Engine? Für eine WinBoard-Engine wähle das WinBoard-Protokoll."

msgid "! {} pair with one game only"
msgid_plural "! {} pairs with one game only"
msgstr[0] "! {} Paar mit nur einer Partie"
msgstr[1] "! {} Paare mit nur einer Partie"

msgid "! {} wrong PVs, on the moves in this colour"
msgstr "! {} falsche PVs, bei den Zügen in dieser Farbe"

msgid "%.1f pawns"
msgstr "%.1f Bauern"

