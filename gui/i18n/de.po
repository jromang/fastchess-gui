msgstr "%d Halbzüge"

msgid "%d · every move alike"
msgstr "%d · jeder Zug gleich"

msgid "%d · moves by their weights"
msgstr "%d · Züge nach ihrem Gewicht"

msgid "%d · the best moves only"
msgstr "%d · nur die besten Züge"

msgid "%d · toward every move alike"
msgstr "%d · Richtung jeder Zug gleich"

msgid "%d · toward the best moves"
msgstr "%d · Richtung beste Züge"

msgid "%s  vs  %s"
msgstr "%s  gegen  %s"

msgid "%s: %d loss(es) on time, %d crash(es), %d illegal move(s)"
msgstr "%s: %d Zeitverlust/-verluste, %d Absturz/Abstürze, %d illegale(r) Zug/Züge"

msgid "(+{} tournament)"
msgid_plural "(+{} tournaments)"
msgstr[0] "(+{} Turnier)"
msgstr[1] "(+{} Turniere)"

