# Russian.
msgid ""
msgstr ""
"Project-Id-Version: fastchess-gui\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "  decided at {}"
msgstr "  решение на {}"

msgid " (decided at {})"
msgstr " (решение на {})"

msgid " Export:"
msgstr " Экспорт:"

msgid " · UCI: {} steps passed"
msgstr " · UCI: пройдено этапов — {}"

msgid " · affinity"
msgstr " · привязка к CPU"

msgid " · round trip {:.1f} ms"
msgstr " · задержка сети {:.1f} мс"

msgid " — not a UCI engine? For a WinBoard engine, choose the WinBoard protocol."
msgstr " — не UCI-движок? Для движка WinBoard выберите протокол WinBoard."

msgid "! {} pair with one game only"
msgid_plural "! {} pairs with one game only"
msgstr[0] "! {} пара только с одной партией"
msgstr[1] "! {} пары только с одной партией"
msgstr[2] "! {} пар только с одной партией"

msgid "! {} wrong PVs, on the moves in this colour"
msgstr "! неверных PV: {}, в ходах этого цвета"

msgid "%.1f pawns"
msgstr "%.1f пешки"

msgid "%d cores"
msgstr "ядер: %d"

msgid "%d games × %d threads > %d available threads."
msgstr "Партий × потоков: %d × %d > доступных потоков: %d."

msgid "%d plies"
msgstr "полуходов: %d"

msgid "%d · every move alike"
msgstr "%d · все ходы поровну"

msgid "%d · moves by their weights"
msgstr "%d · ходы по их весу"

msgid "%d · the best moves only"
msgstr "%d · только лучшие ходы"

msgid "%d · toward every move alike"
msgstr "%d · ближе к равным шансам для всех ходов"

msgid "%d · toward the best moves"
msgstr "%d · ближе к лучшим ходам"

msgid "%s  vs  %s"
msgstr "%s  против  %s"

msgid "%s: %d loss(es) on time, %d crash(es), %d illegal move(s)"
msgstr "%s: поражений по времени: %d, вылетов: %d, нелегальных ходов: %d"

msgid "(+{} tournament)"
msgid_plural "(+{} tournaments)"
msgstr[0] "(+{} турнир)"
msgstr[1] "(+{} турнира)"
msgstr[2] "(+{} турниров)"

msgid "(already in the list)"
msgstr "(уже в списке)"

msgid "(choose)"
msgstr "(выбрать)"

msgid "(left out: {} voided, {} duplicates, {} crashes)"
msgstr "(исключены: аннулированных {}, дубликатов {}, вылетов {})"

msgid "(not in the engine list)"
msgstr "(нет в списке движков)"

msgid "(the same)"
msgstr "(без изменений)"

msgid "(twice: give it another book)"
msgstr "(дважды: дайте ему другую книгу)"

msgid "(withdrawn)"
msgstr "(снят)"

msgid "({} pieces or fewer)"
msgstr "(не больше {} фигур)"

msgid "+ Engine"
msgstr "+ Движок"

msgid "+ {} per move"
msgstr "+ {} на ход"

msgid ", CPU affinity"
msgstr ", привязка к CPU"

msgid ", and {} tournament of unknown length"
msgid_plural ", and {} tournaments of unknown length"
msgstr[0] ", и ещё {} турнир неизвестной длительности"
msgstr[1] ", и ещё {} турнира неизвестной длительности"
msgstr[2] ", и ещё {} турниров неизвестной длительности"

msgid ", at its last move"
msgstr ", на его последнем ходу"

msgid ", decided at {}"
msgstr ", решение на {}"

msgid "0 = a new random order for every match."
msgstr "0 = новый случайный порядок для каждого матча."

msgid "0 = each engine's own setting."
msgstr "0 = собственная настройка каждого движка."

msgid "0 = everything the tables cover."
msgstr "0 = всё, что охватывают таблицы."

msgid "0 = no limit."
msgstr "0 = без ограничения."

msgid "0 = the base time covers the whole game. Otherwise it is given again every N moves."
msgstr "0 = базовое время на всю партию. Иначе оно выдаётся заново каждые N ходов."

msgid "0 = the common setting, or the engine's own."
msgstr "0 = общая настройка или собственная настройка движка."

msgid "0 = the common setting: {}"
msgstr "0 = общая настройка: {}"

msgid "0 = the common value: {}"
msgstr "0 = общее значение: {}"

msgid "1 crash"
msgstr "1 вылет"

msgid "1 game exported to {}"
msgstr "1 партия экспортирована в {}"

msgid "1 illegal move"
msgstr "1 нелегальный ход"

msgid "1 loss on time"
msgstr "1 поражение по времени"

msgid "10 games at 10+0.1 from 5 positions, to see before a long tournament whether it loses on time, crashes, plays an illegal move or uses its clock badly."
msgstr "10 партий с контролем 10+0.1 из 5 позиций, чтобы перед долгим турниром проверить, не проигрывает ли движок по времени, не вылетает ли, не делает ли нелегальных ходов и хорошо ли распоряжается временем."

msgid "200 cp: both engines think a side is two pawns ahead, or more."
msgstr "200 cp: оба движка считают, что одна сторона впереди на две пешки или больше."

msgid "200k nodes"
msgstr "200k узлов"

msgid "3D board"
msgstr "3D-доска"

msgid "50 moves {}/100"
msgstr "50 ходов {}/100"

msgid "50-move rule"
msgstr "правило 50 ходов"

msgid "95 % interval"
msgstr "Интервал 95 %"

msgid "= {:.2f} logistic Elo"
msgstr "= {:.2f} Elo по логистической шкале"

msgid "A (tested)"
msgstr "A (тестируемый)"

msgid "A Chat button in the page's header opens this address in a new tab: a Discord invite, a Twitch channel, a forum thread. An https link only. While the games are pushed to lichess, the page also links to the lichess round, which has its own chat."
msgstr "Кнопка «Чат» в шапке страницы открывает этот адрес в новой вкладке: приглашение в Discord, канал Twitch, тему форума. Только https-ссылка. Пока партии отправляются на lichess, страница также ведёт на тур lichess, где есть свой чат."

msgid "A Discord server ID is 17 to 20 digits."
msgstr "ID сервера Discord состоит из 17–20 цифр."

msgid "A FEN, a PGN or a list of moves (e4 e5 Nf3, or e2e4 e7e5) from the clipboard."
msgstr "FEN, PGN или список ходов (e4 e5 Nf3 или e2e4 e7e5) из буфера обмена."

msgid "A PGN book plays the moves of its games, as often as they play them; \"all\" is their first {} plies."
msgstr "Книга PGN играет ходы своих партий так часто, как они в них встречаются; «вся» — это их первые {} полуходов."

msgid "A PGN file of the games shown, in the comment style chosen: the voided games left out, the results set by hand applied."
msgstr "Файл PGN с показанными партиями в выбранном стиле комментариев: без аннулированных партий, с результатами, заданными вручную."

msgid "A PNG, JPEG or SVG picture of 2 MB at most, shown beside the engine's name in Live, on the big screen and on the broadcast web page. A copy is kept in the profile's folder logos: the picture chosen can be moved or deleted."
msgstr "Изображение PNG, JPEG или SVG размером не более 2 МБ, показываемое рядом с именем движка в разделе «Онлайн», на большом экране и на веб-странице трансляции. Копия хранится в папке logos профиля: выбранное изображение можно переместить или удалить."

msgid "A Polyglot book is followed from the initial position to this depth (-1 = {}), leaving out the moves weighing less than a tenth of the best one; the positions reached are the openings."
msgstr "Книга Polyglot просматривается от начальной позиции до этой глубины (-1 = {}), без ходов, вес которых меньше десятой доли веса лучшего; полученные позиции и есть дебюты."

msgid "A WinBoard engine."
msgstr "Движок WinBoard."

msgid "A always White"
msgstr "A всегда белыми"

msgid "A book is being built already: wait for it, or cancel it."
msgstr "Книга уже строится: дождитесь её или отмените."

msgid "A click on a square then empties it. A right click empties a square whatever is chosen."
msgstr "Тогда щелчок по полю очищает его. Щелчок правой кнопкой очищает поле, что бы ни было выбрано."

msgid "A clock: a base time and an increment, the base given again every N moves if you like (tc=40/900, tc=10+0.1)."
msgstr "Часы: основное время и добавка, основное время при желании выдаётся заново каждые N ходов (tc=40/900, tc=10+0.1)."

msgid "A colour won both games of a pair"
msgstr "Один цвет выиграл обе партии пары"

msgid "A command for the engine"
msgstr "Команда для движка"

msgid "A file has no name."
msgstr "У файла нет имени."

msgid "A file of your choice"
msgstr "Файл на ваш выбор"

msgid "A folder is chosen: open it, then Choose this folder."
msgstr "Чтобы выбрать папку, откройте её, затем нажмите «Выбрать эту папку»."

msgid "A folder of 12 SVG pictures named wK.svg, wQ.svg, wR.svg, wB.svg, wN.svg, wP.svg and bK.svg … bP.svg: the white and black king, queen, rook, bishop, knight and pawn."
msgstr "Папка с 12 изображениями SVG с именами wK.svg, wQ.svg, wR.svg, wB.svg, wN.svg, wP.svg и bK.svg … bP.svg: белые и чёрные король, ферзь, ладья, слон, конь и пешка."

msgid "A folder of engines on {}"
msgstr "Папка с движками на {}"

msgid "A format, a time control and the participants."
msgstr "Формат, контроль времени и участники."

msgid "A game between two engines that use a GPU needs two, and this machine has {} (Settings): such a game plays alone."
msgid_plural "A game between two engines that use a GPU needs two, and this machine has {} (Settings): such a game plays alone."
msgstr[0] "Партии двух движков, использующих GPU, нужно два GPU, а на этой машине {} (настройки): такая партия играется одна."
msgstr[1] "Партии двух движков, использующих GPU, нужно два GPU, а на этой машине {} (настройки): такая партия играется одна."
msgstr[2] "Партии двух движков, использующих GPU, нужно два GPU, а на этой машине {} (настройки): такая партия играется одна."

msgid "A game has no port: {}"
msgstr "У партии нет порта: {}"

msgid "A game is flagged when both engines see the same side ahead by the score below for each of their first moves after the book: the Games tab can show those games, the Openings tab marks and counts their openings, the overview counts them. The results are not changed."
msgstr "Партия отмечается, когда оба движка видят одну и ту же сторону впереди не меньше, чем на оценку ниже, на каждом из своих первых ходов после книги: вкладка «Партии» может показать эти партии, вкладка «Дебюты» отмечает и считает их дебюты, обзор их считает. Результаты не меняются."

msgid "A game starts only when the Hash of its two engines, and what each engine process takes besides ({} MB, and {} MB per thread), fit in what the games playing leave: no tournament swaps. Automatic: {} % of the installed memory."
msgstr "Партия начинается, только если Hash двух её движков и то, что каждый процесс движка занимает сверх того ({} МБ и {} МБ на поток), помещаются в то, что оставляют идущие партии: ни один турнир не уходит в подкачку. Автоматически: {} % установленной памяти."

msgid "A game still going after this many moves is adjudicated a draw (-maxmoves)."
msgstr "Партии, не закончившейся за это число ходов, присуждается ничья (-maxmoves)."

msgid "A game, or two with the colours reversed, between two engines of the library from this position, with a clock for each."
msgstr "Партия или две со сменой цвета между двумя движками библиотеки из этой позиции, у каждого свои часы."

msgid "A gauntlet needs at least one engine besides the tested ones."
msgstr "Для гаунтлета нужен хотя бы один движок помимо тестируемых."

msgid "A lichess broadcast: its board, evaluation bar and chat, for anyone, on the internet. The games in progress are pushed every few seconds, each finished game once with its evaluations and clocks."
msgstr "Трансляция на lichess: доска, шкала оценки и чат — для всех, в интернете. Текущие партии отправляются каждые несколько секунд, каждая завершённая партия — один раз, с оценками и показаниями часов."

msgid "A match between two versions, a round robin or a gauntlet."
msgstr "Матч двух версий, круговой турнир или гаунтлет."

msgid "A match is already running."
msgstr "Матч уже идёт."

msgid "A match is running. The games in progress will be lost."
msgstr "Идёт матч. Текущие партии будут потеряны."

msgid "A mate score's PV must have the right length and end in mate. PVs are always checked for illegal moves; the moves whose PV is wrong are marked in the Games tab."
msgstr "PV матовой оценки должен иметь правильную длину и заканчиваться матом. PV всегда проверяются на нелегальные ходы; ходы с неверным PV отмечаются на вкладке «Партии»."

msgid "A message of the tournament's process could not be read: {}"
msgstr "Не удалось прочитать сообщение процесса турнира: {}"

msgid "A move counts when the player who made it is rated this or more, by the game's WhiteElo or BlackElo tag; a player without a rating is left out."
msgstr "Ход учитывается, если у сделавшего его игрока рейтинг не ниже этого, по тегу WhiteElo или BlackElo партии; игрок без рейтинга не учитывается."

msgid "A move is kept when at least this many games play it in its position; the others are left out as played too rarely (Polyglot's -min-game)."
msgstr "Ход сохраняется, если в его позиции его играют не меньше этого числа партий; остальные отбрасываются как слишком редкие (-min-game в Polyglot)."

msgid "A move weighs the number of games that play it, whatever their results."
msgstr "Вес хода — число партий, в которых он сыгран, независимо от их результатов."

msgid "A move weighs the points the side that played it made in its games: a win 2, a draw 1, a loss 0, as Polyglot counts. The games without a result are left out, and so is a move whose games were all lost."
msgstr "Вес хода — очки, набранные в его партиях стороной, которая его сделала: победа 2, ничья 1, поражение 0, как считает Polyglot. Партии без результата отбрасываются, как и ход, все партии с которым проиграны."

msgid "A network engine that plays on a graphics card (Lc0...): no more such engines play at once than the GPUs of Settings ({}), in a tournament and across tournaments. From the next tournament it joins."
msgstr "Сетевой движок, играющий на видеокарте (Lc0…): таких движков одновременно играет не больше, чем GPU в настройках ({}), в одном турнире и между турнирами. С ближайшего турнира, в который он войдёт."

msgid "A new tournament with this one's participants and settings, to change before it starts: another time control, the next version of an engine."
msgstr "Новый турнир с участниками и настройками этого, которые можно изменить до старта: другой контроль времени, следующая версия движка."

msgid "A or B of the match."
msgstr "A или B матча."

msgid "A page that opens in any browser, light or dark, with a header that tells how the list was made: sources, games, anchor and filters."
msgstr "Страница, которая открывается в любом браузере, светлая или тёмная, с заголовком о том, как составлен список: источники, партии, опора и фильтры."

msgid "A page, an engine, a tournament, an action…"
msgstr "Страница, движок, турнир, действие…"

msgid "A participant already."
msgstr "Уже участник."

msgid "A participant's own, from its ⋯ menu, comes first."
msgstr "Собственное значение участника из его меню ⋯ важнее."

msgid "A path there, typed or pasted, then Enter."
msgstr "Путь на машине: введите или вставьте его, затем нажмите Enter."

msgid "A pawn is on the first or the last rank."
msgstr "Пешка стоит на первой или последней горизонтали."

msgid "A position the tablebases win only past the 50-move rule (a cursed win) is adjudicated a win rather than a draw (-tbignore50)."
msgstr "Позиция, которую таблицы выигрывают лишь за пределами правила 50 ходов («проклятый выигрыш»), присуждается как выигрыш, а не ничья (-tbignore50)."

msgid "A preset of the program."
msgstr "Готовый профиль программы."

msgid "A preset of this name: your profile takes its place."
msgstr "Готовый профиль с этим именем: ваш займёт его место."

msgid "A private key file, RSA or Ed25519 (~/.ssh/id_ed25519): its passphrase, if it has one, is asked once a session and never saved."
msgstr "Файл закрытого ключа, RSA или Ed25519 (~/.ssh/id_ed25519): его парольная фраза, если она есть, запрашивается один раз за сеанс и никогда не сохраняется."

msgid "A profile of this name: it is replaced."
msgstr "Профиль с этим именем: он будет заменён."

msgid "A program of this computer…"
msgstr "Программа на этом компьютере…"

msgid "A program on {}"
msgstr "Программа на {}"

msgid "A program on {}…"
msgstr "Программа на {}…"

msgid "A program there… (a new engine of the library)"
msgstr "Программа на этой машине… (новый движок библиотеки)"

msgid "A rating list's text or web page, Ordo, CSV (name,elo)"
msgstr "Текст или веб-страница рейтинг-листа, Ordo, CSV (name,elo)"

msgid "A rating list, for the reference Elo…"
msgstr "Рейтинг-лист для опорного рейтинга Elo…"

msgid "A second entry for the same program, to play it with other options: another Hash, a skill level, another network."
msgstr "Вторая запись для той же программы, чтобы играть с другими параметрами: другой Hash, уровень силы, другая сеть."

msgid "A second game, the colours reversed"
msgstr "Вторая партия со сменой цвета"

msgid "A second participant with the same engine, to give it another book: each copy plays as engine (book), its results and rating apart."
msgstr "Второй участник с тем же движком, чтобы дать ему другую книгу: каждая копия играет как «движок (книга)», со своими результатами и рейтингом."

msgid "A separate engine"
msgstr "Отдельный движок"

msgid "A server that lets the user in without a key or a password (authentication \"none\"): a service of that kind, or a server of yours."
msgstr "Сервер, пускающий пользователя без ключа и пароля (аутентификация «none»): такой сервис или ваш собственный сервер."

msgid "A short knock for each move of the game followed, in Live and on the big screen, a heavier one for a capture; not for every game of the mosaic."
msgstr "Короткий стук на каждый ход отслеживаемой партии, в разделе «Онлайн» и на большом экране, более тяжёлый при взятии; не для каждой партии мозаики."

msgid "A sound for each move"
msgstr "Звук на каждый ход"

msgid "A table that GitHub and forums show as one, with the same header as the HTML page."
msgstr "Таблица, которую GitHub и форумы показывают как таблицу, с тем же заголовком, что и HTML-страница."

msgid "A team match board by board takes no new engine: its board would have no opponent. Replace an engine of a team instead."
msgstr "Командный матч по доскам не принимает новый движок: на его доске не было бы соперника. Вместо этого замените движок одной из команд."

msgid "A team match needs an engine in each team: put one in the other team (the participant's ⋯)."
msgstr "Командному матчу нужен движок в каждой команде: переведите один в другую команду (⋯ участника)."

msgid "A template is the whole setup: a profile for each section, and what no profile holds (the name, the participants, the concurrency, the PGN files, the broadcast). A section that played as its profile takes the profile's values of the day."
msgstr "Шаблон — это вся настройка: профиль для каждого раздела и то, чего нет ни в одном профиле (название, участники, параллельность, файлы PGN, трансляция). Раздел, совпадавший со своим профилем, получает текущие значения профиля."

msgid "A test box, a server or a second PC with an SSH server (on Windows, its built-in OpenSSH Server): the window logs in with your SSH agent or a key file, finds out the machine, installs fastchess-gui there and copies the books and tablebases. Nothing secret is saved: the key's passphrase is asked once a session."
msgstr "Тестовая машина, сервер или второй ПК с сервером SSH (в Windows — встроенный OpenSSH Server): окно входит через ваш агент SSH или файл ключа, определяет машину, устанавливает туда fastchess-gui и копирует книги и эндшпильные таблицы. Ничего секретного не сохраняется: парольная фраза ключа запрашивается раз за сеанс."

msgid "A tournament is running: the analysis competes with its games ({} threads)."
msgstr "Идёт турнир: анализ конкурирует с его партиями ({} потоков)."

msgid "A tournament is running: what this engine searches takes cores from its games."
msgstr "Идёт турнир: расчёты этого движка отнимают ядра у его партий."

msgid "A tournament waits to start."
msgstr "Турнир ожидает запуска."

msgid "A1, A2… are team A, B1, B2… team B: the upper half of the list against the lower half, until engines are put in a team with their ⋯ or the Team A and Team B buttons under the list. Board by board, A1 plays B1, A2 plays B2, and so on."
msgstr "A1, A2… — команда A, B1, B2… — команда B: верхняя половина списка против нижней, пока движки не распределены по командам через их ⋯ или кнопки «Команда A» и «Команда B» под списком. По доскам A1 играет с B1, A2 с B2 и так далее."

msgid "A: +%d  =%d  -%d"
msgstr "A: +%d  =%d  -%d"

msgid "A: an engine of the library analyses the position."
msgstr "A: движок из библиотеки анализирует позицию."

msgid "A: analyse it on the Board page"
msgstr "A: анализировать на странице «Доска»"

msgid "API token (with the study:write scope)"
msgstr "API-токен (с правом study:write)"

