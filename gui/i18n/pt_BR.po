msgid "Add to the queue"
msgstr "Adicionar à fila"

msgid "Add {}"
msgstr "Adicionar {}"

msgid "Add {} engine"
msgid_plural "Add {} engines"
msgstr[0] "Adicionar {} motor"
msgstr[1] "Adicionar {} motores"

msgid "Added to elo0 and elo1, for a test against a version known to be stronger or weaker by that much: the SPRT is given [elo0 + bias, elo1 + bias]."
msgstr "Somado a elo0 e elo1, para um teste contra uma versão sabidamente mais forte ou mais fraca nessa medida: o SPRT recebe [elo0 + viés, elo1 + viés]."

msgid "Adds an opening book of yours, EPD, PGN or Polyglot (.bin), to the library: the setup's Openings then offer it by name. The file stays where it is."
msgstr "Adiciona um livro de aberturas seu, EPD, PGN ou Polyglot (.bin), à biblioteca: as Aberturas da configuração passam a oferecê-lo pelo nome. O arquivo continua onde está."

msgid "Adds the columns of an earlier run of this suite to the grid, to compare versions of an engine."
msgstr "Adiciona à grade as colunas de uma execução anterior desta suíte, para comparar versões de um engine."

msgid "Add…"
msgstr "Adicionar…"

msgid "Add… ▾"
msgstr "Adicionar… ▾"

msgid "Adjudicate"
msgstr "Adjudicar"

msgid "Adjudicated by the operator"
msgstr "Adjudicada pelo operador"

msgid "Adjudication"
msgstr "Adjudicação"

msgid "Adjudication up to {} piece, but only {}-piece files found in {}."
msgid_plural "Adjudication up to {} pieces, but only {}-piece files found in {}."
msgstr[0] "Adjudicação até {} peça, mas só há arquivos de {} peças em {}."
msgstr[1] "Adjudicação até {} peças, mas só há arquivos de {} peças em {}."

msgid "Adjudications"
msgstr "Adjudicações"

msgid "Affinity ignored: an engine uses %d threads."
msgstr "Afinidade ignorada: um engine usa %d threads."

msgid "After the folder's files were changed."
msgstr "Depois que os arquivos da pasta forem alterados."

msgid "After the running match."
msgstr "Depois do match em andamento."

msgid "After the running tournament: its end ends every engine."
msgstr "Depois do torneio em andamento: o fim dele encerra todas as engines."

msgid "Agreement"
msgstr "Concordância"

msgid "All"
msgstr "Todas"

msgid "All 324 positions…"
msgstr "As 324 posições…"

msgid "All engines"
msgstr "Todos os engines"

msgid "All files"
msgstr "Todos os arquivos"

msgid "All games played"
msgstr "Todas as partidas jogadas"

msgid "All groups"
msgstr "Todos os grupos"

msgid "All openings"
msgstr "Todas as aberturas"

msgid "All these engines are already in the library."
msgstr "Todos esses engines já estão na biblioteca."

msgid "All to default"
msgstr "Tudo no padrão"

msgid "All tournaments"
msgstr "Todos os torneios"

msgid "Also append every game to:"
msgstr "Também adicionar cada partida a:"

msgid "Also as a zip"
msgstr "Também em zip"

msgid "Alternate"
