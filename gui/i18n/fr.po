msgstr "Toutes"

msgid "All 324 positions…"
msgstr "Les 324 positions…"

msgid "All engines"
msgstr "Tous les moteurs"

msgid "All files"
msgstr "Tous les fichiers"

msgid "All games played"
msgstr "Toutes les parties jouées"

msgid "All groups"
msgstr "Tous les groupes"

msgid "All openings"
msgstr "Toutes les ouvertures"

msgid "All these engines are already in the library."
msgstr "Tous ces moteurs sont déjà dans la bibliothèque."

msgid "All to default"
msgstr "Tout par défaut"

msgid "All tournaments"
msgstr "Tous les tournois"

msgid "Also append every game to:"
msgstr "Ajouter aussi chaque partie à :"

