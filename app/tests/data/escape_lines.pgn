% An opening book with escape lines [PGN standard 6]
% They must be ignored wherever they are.

[Event "?"]
[Result "*"]

% before the moves
1. e4 e5 2. Nf3 Nc6 *

[Event "?"]
% inside the headers
[Result "*"]

1. d4 d5
% inside the move text
2. c4 *
% between games

[Event "?"]
[Result "*"]

1. c4 c5 *
