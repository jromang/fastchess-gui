# Turns the .po files into C++ byte arrays, listed with their language codes (the file names).
# Usage: cmake -DOUT=<file.cpp> -DFILES=<a.po|b.po|...> -P embed_po.cmake

string(REPLACE "|" ";" FILES "${FILES}")
set(ARRAYS "")
set(ENTRIES "")
set(COUNT 0)
foreach(po IN LISTS FILES)
    get_filename_component(code ${po} NAME_WE)
    file(READ ${po} HEX HEX)
    string(LENGTH "${HEX}" HEX_LENGTH)
    math(EXPR SIZE "${HEX_LENGTH} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" BYTES "${BYTES}")
    string(APPEND ARRAYS "const unsigned char po_${COUNT}[] = {\n${BYTES}};\n\n")
    string(APPEND ENTRIES "    {\"${code}\", po_${COUNT}, ${SIZE}},\n")
    math(EXPR COUNT "${COUNT} + 1")
endforeach()

file(WRITE ${OUT}.tmp "// Generated by cmake/embed_po.cmake - do not edit.\n#include <cstddef>\n\nnamespace fcg::assets {\n\nstruct PoFile {\n    const char* code;\n    const unsigned char* data;\n    std::size_t size;\n};\n\nextern const PoFile po_files[];\nextern const std::size_t po_files_count;\n\nnamespace {\n${ARRAYS}}  // namespace\n\nconst PoFile po_files[] = {\n${ENTRIES}    {nullptr, nullptr, 0},\n};\nconst std::size_t po_files_count = ${COUNT};\n\n}  // namespace fcg::assets\n")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUT}.tmp)
