# Turns the piece sets gui/assets/pieces/<set>/*.svg into a C++ table of string literals (see gui/src/piece_sets.hpp).
# Usage: cmake -DOUT=<file.cpp> -DDIR=<pieces dir> "-DSETS=<set>|<set>|..." -P embed_pieces.cmake
# The first set is the default one.

set(PIECES wK wQ wR wB wN wP bK bQ bR bB bN bP)
string(REPLACE "|" ";" SETS "${SETS}")
list(LENGTH SETS COUNT)

set(BODY "// Generated by cmake/embed_pieces.cmake - do not edit.\n")
string(APPEND BODY "#include \"piece_sets.hpp\"\n\nnamespace fcg::assets {\n\n")
string(APPEND BODY "// Each set's pieces: white K Q R B N P, then black K Q R B N P.\n")
string(APPEND BODY "const PieceSetSvgs piece_sets[] = {\n")

foreach(S ${SETS})
    string(APPEND BODY "    {\"${S}\",\n     {\n")
    foreach(P ${PIECES})
        file(READ ${DIR}/${S}/${P}.svg SVG)
        string(APPEND BODY "         R\"fcgsvg(${SVG})fcgsvg\",\n")
    endforeach()
    string(APPEND BODY "     }},\n")
endforeach()

string(APPEND BODY "};\n\nconst std::size_t piece_set_count = ${COUNT};\n\n}  // namespace fcg::assets\n")

file(WRITE ${OUT}.tmp "${BODY}")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUT}.tmp)
