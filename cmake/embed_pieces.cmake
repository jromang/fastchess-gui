# Turns gui/assets/pieces/*.svg into a C++ table of string literals.
# Usage: cmake -DOUT=<file.cpp> -DDIR=<svg dir> -P embed_pieces.cmake

set(PIECES wK wQ wR wB wN wP bK bQ bR bB bN bP)

set(BODY "// Generated by cmake/embed_pieces.cmake - do not edit.\n")
string(APPEND BODY "#include <array>\n#include <string_view>\n\nnamespace fcg::assets {\n\n")
string(APPEND BODY "// Order: white K Q R B N P, then black K Q R B N P.\n")
string(APPEND BODY "extern const std::array<std::string_view, 12> piece_svgs;\n")
string(APPEND BODY "const std::array<std::string_view, 12> piece_svgs = {\n")

foreach(P ${PIECES})
    file(READ ${DIR}/${P}.svg SVG)
    string(APPEND BODY "    R\"fcgsvg(${SVG})fcgsvg\",\n")
endforeach()

string(APPEND BODY "};\n\n}  // namespace fcg::assets\n")

file(WRITE ${OUT}.tmp "${BODY}")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUT}.tmp)
