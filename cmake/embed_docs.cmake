# Turns the user guide and its pictures into C++ byte arrays, each listed under its name: "guide.md", "guide.fr.md",
# "screenshots/appearance.png" (the path a guide's Markdown gives it). The Markdown files are gzipped (a third of
# their size), the pictures kept as they are (PNG is compressed already).
# Usage: cmake -DOUT=<file.cpp> -DFILES=<name=path|name=path|...> -P embed_docs.cmake

string(REPLACE "|" ";" FILES "${FILES}")
set(ARRAYS "")
set(ENTRIES "")
set(COUNT 0)
foreach(entry IN LISTS FILES)
    string(FIND "${entry}" "=" eq)
    string(SUBSTRING "${entry}" 0 ${eq} name)
    math(EXPR start "${eq} + 1")
    string(SUBSTRING "${entry}" ${start} -1 path)
    set(gzipped false)
    if(name MATCHES "\\.md$")
        set(gz ${OUT}.${COUNT}.gz)
        file(ARCHIVE_CREATE OUTPUT ${gz} PATHS ${path} FORMAT raw COMPRESSION GZip COMPRESSION_LEVEL 9)
        file(READ ${gz} HEX HEX)
        file(REMOVE ${gz})
        # The header's modification time (bytes 4 to 7) set to 0, so that the same guide gives the same bytes.
        string(SUBSTRING "${HEX}" 0 8 head)
        string(SUBSTRING "${HEX}" 16 -1 tail)
        set(HEX "${head}00000000${tail}")
        set(gzipped true)
    else()
        file(READ ${path} HEX HEX)
    endif()
    string(LENGTH "${HEX}" HEX_LENGTH)
    math(EXPR SIZE "${HEX_LENGTH} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" BYTES "${BYTES}")
    string(APPEND ARRAYS "const unsigned char doc_${COUNT}[] = {\n${BYTES}};\n\n")
    string(APPEND ENTRIES "    {\"${name}\", doc_${COUNT}, ${SIZE}, ${gzipped}},\n")
    math(EXPR COUNT "${COUNT} + 1")
endforeach()

file(WRITE ${OUT}.tmp "// Generated by cmake/embed_docs.cmake - do not edit.\n#include <cstddef>\n\nnamespace fcg::assets {\n\nstruct DocFile {\n    const char* name;\n    const unsigned char* data;\n    std::size_t size;\n    bool gzipped;  // a gzip member (RFC 1952) of the file\n};\n\nextern const DocFile doc_files[];\nextern const std::size_t doc_files_count;\n\nnamespace {\n${ARRAYS}}  // namespace\n\nconst DocFile doc_files[] = {\n${ENTRIES}    {nullptr, nullptr, 0, false},\n};\nconst std::size_t doc_files_count = ${COUNT};\n\n}  // namespace fcg::assets\n")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUT}.tmp)
