# Turns a binary file into a C++ byte array.
# Usage: cmake -DIN=<file> -DOUT=<file.cpp> -DSYMBOL=<name> -P embed_binary.cmake

file(READ ${IN} HEX HEX)
string(LENGTH "${HEX}" HEX_LENGTH)
math(EXPR SIZE "${HEX_LENGTH} / 2")

string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" BYTES "${BYTES}")

file(WRITE ${OUT}.tmp "// Generated by cmake/embed_binary.cmake - do not edit.\n#include <cstddef>\n\nnamespace fcg::assets {\n\nextern const unsigned char ${SYMBOL}[];\nextern const std::size_t ${SYMBOL}_size;\n\nalignas(4) const unsigned char ${SYMBOL}[] = {\n${BYTES}};\nconst std::size_t ${SYMBOL}_size = ${SIZE};\n\n}  // namespace fcg::assets\n")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUT}.tmp)
